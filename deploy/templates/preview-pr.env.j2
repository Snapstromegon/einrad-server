# Managed by Ansible (deploy/preview-pr.yml), changes here are overwritten.
# The environment of {{ cup_service }}, without secrets: JWT_SECRET and
# RELOAD_DB_TOKEN are in secrets.env, generated on the VM. The database and
# data/ are the defaults in the working directory; the competition comes
# from demo-data.toml (seed_demo).
BASE_URL={{ pr_base_url }}
HTTP_ADDRESS=0.0.0.0:{{ cup_port }}
# Mailpit (deploy/mailpit.yml): no TLS, no login. SMTP_USER is the sender;
# the server requires a password, which Mailpit ignores.
SMTP_SERVER=smtp://127.0.0.1:{{ mailpit_smtp_port }}
SMTP_USER=noreply@{{ pr_domain }}
SMTP_PASSWORD=unused
